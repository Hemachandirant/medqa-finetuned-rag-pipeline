# ─────────────────────────────────────────────
# HuggingFace Secrets
# ─────────────────────────────────────────────
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN="your_hf_token_here"
HF_MODEL_ID="Hemachandiran/medqa-deepseek_v1"
HF_API_URL="https://api-inference.huggingface.co/models/Hemachandiran/medqa-deepseek_v1"

# ─────────────────────────────────────────────
# AWS SageMaker Configuration
# ─────────────────────────────────────────────
# Get these from your AWS account
AWS_REGION="ap-south-1"
IAM_ROLE_ARN="arn:aws:iam::YOUR_ACCOUNT_ID:role/SageMakerExecutionRole"
ENDPOINT_NAME="medqa-deepseek-v2"

# ─────────────────────────────────────────────
# Azure OpenAI (for embeddings)
# ─────────────────────────────────────────────
# Get these from your Azure account
AZURE_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_API_KEY="your_azure_api_key_here"
AZURE_API_VERSION="2024-02-01"
AZURE_DEPLOYMENT="text-embedding-3-small"

# ─────────────────────────────────────────────
# Model Configuration
# ─────────────────────────────────────────────
INSTANCE_TYPE="ml.g4dn.xlarge"
MAX_NEW_TOKENS=256
